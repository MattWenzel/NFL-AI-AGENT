# Git + IDE + OS cruft
.git
.gitignore
.gitattributes
.vscode
.idea
.DS_Store

# Python build artifacts
__pycache__
*.py[cod]
*$py.class
*.egg-info
.pytest_cache
.mypy_cache
.ruff_cache

# Virtual environments
.venv
venv
env

# Tests never ship in the runtime image
tests/

# Frontend node_modules and any local Vite build never ship in the image —
# the multi-stage Dockerfile installs deps and runs `npm run build` itself,
# producing /build/dist which is then COPY-ed into the runtime stage. Local
# build artifacts could be stale or platform-specific.
frontend/node_modules/
frontend/dist/

# Secrets + local state never ship in the image. The SQLite runtime DB
# and the NFL DBs are on the volume; exports are regenerated.
.env
.env.*
data/
exports/
NFLVERSE/data/
NFLVERSE/raw/

# Logs + scratch
*.log
/tmp/

# Claude Code metadata
.claude/

# Plan + memory + scratch paths outside repo root are already excluded
# by git; keeping them here for defense-in-depth.
